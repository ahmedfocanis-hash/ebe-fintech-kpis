{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["kpis.db", "public/avatars/**"]
      }
    },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/avatars/(.*)", "dest": "/avatars/$1" },
    { "src": "/(.*)", "dest": "/dist/$1", "check": true },
    { "src": "/.*", "dest": "/dist/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
